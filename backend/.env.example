# InterviewAI backend environment

MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/<database>"
MONGODB_DB_NAME="interviewai"

# Speech-to-text only. Language generation never uses Groq.
GROQ_API_KEY=""

# NVIDIA API Catalog free endpoint key for interview turns and reports.
NVIDIA_API_KEY=""
# Optional overrides; defaults are already configured in the application.
# NVIDIA_REALTIME_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
# NVIDIA_ANALYSIS_MODEL="nvidia/nemotron-3-super-120b-a12b"
# NVIDIA_REALTIME_THINKING="false"
# NVIDIA_ANALYSIS_THINKING="true"

CORS_ORIGINS="http://localhost:3000"
